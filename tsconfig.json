{
  "include": [
    "./src/**/*"
  ],
  "compilerOptions": {
    "target": "es2023",
    "moduleResolution": "bundler",
    "types": [],
    "lib": [
      "es2023",
      "dom"
    ],
    "rootDir": "./src/",
    "declaration": true,
    "strict": true,
    "removeComments": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleDetection": "legacy",
    "outDir": "./build/"
  }
}
